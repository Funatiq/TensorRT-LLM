  "_copyright": "Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.",
  "_license": "Apache-2.0",
  "boundaries": [
    {
      "name": "Components must not depend on the facade or language bindings",
      "from": [
        "tllm_common_*",
        "tllm_runtime_*",
        "ipc_nvls_memory_src",
        "tllm_executor_*",
        "tllm_batch_*",
        "tllm_kv_cache*",
        "tllm_context_transfer_*",
        "tllm_peft_cache",
        "tllm_kernel_*"
      ],
      "to": [
        "tensorrt_llm",
        "bindings",
        "th_common",
        "th_common_*",
        "th_utils",
        "tensorrt_llm_transfer_agent_binding"
      ],
      "from_directories": [
        "source/tensorrt_llm/common",
        "source/tensorrt_llm/common/*",
        "source/tensorrt_llm/runtime",
        "source/tensorrt_llm/runtime/*",
        "source/tensorrt_llm/executor",
        "source/tensorrt_llm/executor/*",
        "source/tensorrt_llm/batch_manager",
        "source/tensorrt_llm/batch_manager/*",
        "source/tensorrt_llm/kernels",
        "source/tensorrt_llm/kernels/*"
      ],
      "exclude_from": [
        "tensorrt_llm_transfer_agent_binding"
      ],
      "exclude_from_directories": [
        "source/tests",
        "source/tests/*",
        "source/micro_benchmarks",
        "source/micro_benchmarks/*"
      ],
      "forbid_facade_libraries": true
    },
    {
      "name": "Production components must not depend on tests or benchmarks",
      "from": [
        "tllm_common_*",
        "tllm_runtime_*",
        "ipc_nvls_memory_src",
        "tllm_executor_*",
        "tllm_batch_*",
        "tllm_kv_cache*",
        "tllm_context_transfer_*",
        "tllm_peft_cache",
        "tllm_kernel_*",
        "kernels_src",
        "cutlass_src",
        "tensorrt_llm"
      ],
      "to": [
        "google-tests",
        "*-tests",
        "*Test",
        "*Test_*",
        "*_test",
        "*_benchmark",
        "micro_benchmarks"
      ],
      "to_directories": [
        "source/tests",
        "source/tests/*",
        "source/micro_benchmarks",
        "source/micro_benchmarks/*"
      ],
      "from_directories": [
        "source/tensorrt_llm/common",
        "source/tensorrt_llm/common/*",
        "source/tensorrt_llm/runtime",
        "source/tensorrt_llm/runtime/*",
        "source/tensorrt_llm/executor",
        "source/tensorrt_llm/executor/*",
        "source/tensorrt_llm/batch_manager",
        "source/tensorrt_llm/batch_manager/*",
        "source/tensorrt_llm/kernels",
        "source/tensorrt_llm/kernels/*"
      ],
      "exclude_from": [
        "tensorrt_llm_transfer_agent_binding"
      ],
      "exclude_from_directories": [
        "source/tests",
        "source/tests/*",
        "source/micro_benchmarks",
        "source/micro_benchmarks/*"
      ]
    },
    {
      "name": "Focused Torch families must remain component-local",
      "from": [
        "th_common_sequence",
        "th_common_visual_gen",
        "torchSequenceRegistrationTest",
        "torchVisualGenRegistrationTest"
      ],
      "to": [
        "tensorrt_llm",
        "bindings",
        "th_common",
        "th_common_attention",
        "th_common_gemm_quant",
        "th_common_moe",
        "th_common_distributed",
        "th_common_decoding",
        "pg_utils",
        "kernels_src",
        "cutlass_src",
        "context_attention_src",
        "_context_attention_kernels_*",
        "decoder_attention_src",
        "decoder_masked_multihead_attention*",
        "flash_mla_src",
        "trtllm_gen_*",
        "*gemm*",
        "*moe*",
        "tllm_kernel_ulysses",
        "tllm_kernel_communication",
        "tllm_common_nccl*",
        "tllm_runtime_distributed",
        "tensorrt_llm_*_wrapper",
        "*attention*",
        "*fmha*",
        "*mla*",
        "tllm_runtime_nccl",
        "tllm_runtime_ipc*",
        "tllm_runtime_locality",
        "tllm_runtime_multicast",
        "tllm_runtime_nvls_buffers",
        "deep_ep*",
        "nvshmem*"
      ],
      "forbid_facade_libraries": true,
      "include_tests": true
    },
    {
      "name": "Decoding Torch consumers must avoid facade and unrelated backends",
      "from": [
        "th_common_decoding",
        "torchDecodingRegistrationTest"
      ],
      "to": [
        "tensorrt_llm",
        "bindings",
        "th_common",
        "th_common_attention",
        "th_common_gemm_quant",
        "th_common_moe",
        "th_common_distributed",
        "pg_utils",
        "kernels_src",
        "cutlass_src",
        "*attention*",
        "*fmha*",
        "*mla*",
        "*moe*",
        "tllm_runtime_distributed",
        "tllm_common_nccl*",
        "tensorrt_llm_*_wrapper"
      ],
      "forbid_facade_libraries": true,
      "include_tests": true
    },
    {
      "name": "GEMM Torch consumers must avoid facade and attention/MoE backends",
      "from": [
        "th_common_gemm_quant",
        "torchGemmQuantRegistrationTest",
        "th_tensor_allocators"
      ],
      "to": [
        "tensorrt_llm",
        "bindings",
        "th_common",
        "th_common_attention",
        "th_common_moe",
        "th_common_distributed",
        "pg_utils",
        "kernels_src",
        "cutlass_src",
        "*attention*",
        "*fmha*",
        "*mla*",
        "tllm_kernel_moe*",
        "moe_gemm_src",
        "trtllm_gen_fp8_block_scale_moe*",
        "tensorrt_llm_*_wrapper"
      ],
      "forbid_facade_libraries": true,
      "include_tests": true
    }
  ],
  "component_test_forbidden": [
    "tensorrt_llm",
    "bindings",
    "th_common",
    "th_common_*"
  ],
  "lightweight_tests": [
    "stringUtilsTest",
    "executorConfigTest",
    "contextTransferCoordinatorTest"
  ],
  "lightweight_forbidden": [
    "tensorrt_llm",
    "bindings",
    "th_utils",
    "th_common*",
    "kernels_src",
    "cutlass_src",
    "context_attention_src",
    "_context_attention_kernels_*",
    "decoder_attention_src",
    "decoder_masked_multihead_attention*",
    "flash_mla_src"
  ],
  "duplicate_source_allowlist": [],
  "duplicate_source_errors": [
    "source/tensorrt_llm/kernels/*",
    "build/tensorrt_llm/kernels/*"
  ],
  "duplicate_owner_directories": [
    "source/tensorrt_llm/kernels",
    "source/tensorrt_llm/kernels/*"
  ],
  "component_test_allowed": [
    "th_common_sequence",
    "th_common_visual_gen",
    "th_common_decoding",
    "th_common_gemm_quant"
  ]
}
